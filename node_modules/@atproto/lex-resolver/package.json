{
  "name": "@atproto/lex-resolver",
  "version": "0.3.2",
  "license": "MIT",
  "description": "Lexicon document resolver utility for AT Lexicons",
  "keywords": [
    "atproto",
    "lexicon",
    "resolver",
    "utility"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lex/lex-resolver"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "@atproto-labs/did-resolver": "^0.3.10",
    "@atproto/lex-client": "^0.3.7",
    "@atproto/lex-data": "^0.1.8",
    "@atproto/lex-document": "^0.1.13",
    "@atproto/lex-schema": "^0.2.8",
    "@atproto/crypto": "^0.5.7",
    "@atproto/repo": "^0.11.0",
    "@atproto/syntax": "^0.7.6"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "@atproto/lex-builder": "^0.1.17"
  },
  "scripts": {
    "codegen:lex": "node ./scripts/lex-build.js",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}