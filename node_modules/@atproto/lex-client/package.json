{
  "name": "@atproto/lex-client",
  "version": "0.3.7",
  "license": "MIT",
  "description": "HTTP client for interacting with Lexicon based APIs",
  "keywords": [
    "atproto",
    "lexicon",
    "xrpc",
    "client"
  ],
  "homepage": "https://atproto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/atproto",
    "directory": "packages/lex/lex-client"
  },
  "files": [
    "./dist",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "@atproto/lex-data": "^0.1.8",
    "@atproto/lex-schema": "^0.2.8",
    "@atproto/lex-json": "^0.1.7"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "@atproto/lex-builder": "^0.1.17",
    "@atproto/lex-cbor": "^0.1.7"
  },
  "scripts": {
    "codegen:lex": "node ./scripts/lex-build.js",
    "prebuild": "pnpm run '/^(codegen:.+)$/'",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  }
}